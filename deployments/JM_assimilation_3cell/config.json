        "noise_sigma": {
            "default": 0.0,
            "Precipitation": 0.0,
            "DA-01 runoff": 0.1,
            "Gutter 3 depth": 0.02,
            "Pond 1 water depth": 0.02,
            "Pond 2 water depth": 0.02,
            "Pond 3 water depth": 0.02,
            "Soil 1 moisture": 0.05,
            "Soil 2 moisture": 0.05,
            "Soil 3 moisture": 0.05,
            "Pond 1 infiltration": 0.1,
            "Pond 2 infiltration": 0.1,
            "Pond 3 infiltration": 0.1,
            "Pond 1 overflow": 0.1,
            "Pond 2 overflow": 0.1,
            "Pond 3 overflow": 0.1,
            "Underdrain outlet flow": 0.1,
            "Groundwater recharge": 0.1,
            "Catch basin depth": 0.02,
            "Catch basin outlet flow": 0.1,
            "Soil 1 evaporation": 0.0,
            "Soil 2 evaporation": 0.0,
            "Soil 3 evaporation": 0.0

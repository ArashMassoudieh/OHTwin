{
    "deployment": {
        "name": "Bioretention_assimilation_MCMC_drift_SE",
        "model_file": "model/Bioretention.ohq",
        "viz_file": "viz_bioretention.json",
        "port": 8185
    },
    "runtime": {
        "weather_source": "openmeteo_historical",
        "latitude": 39.06088,
        "longitude": -77.13569,
        "interval": "1day",
        "forecast_horizon": "6day",
        "start_datetime": "2020-01-03T00:00:00",
        "stop_datetime": "2022-01-03T00:00:00",
        "time_acceleration": 200,
        "advance_to_observations": true,
        "state_variables": [],
        "keep_debug_outputs": true
    },
    "observations": {
        "save_interval": "1hr",
        "noise_sigma": 0.0
    },
    "logging": {
        "enabled": true,
        "file": "outputs/debug.log",
        "categories": [
            "assim",
            "mcmc",
            "snapshot"
        ],
        "flush_every": 1,
        "truncate": true
    },
    "assimilation": {
        "truth_csv_url": "http://localhost:8086/outputs/selected_output.csv",
        "truth_meta_url": "http://localhost:8086/outputs/selected_output_meta.json",
        "posterior_snapshot_path": "outputs/calibration/posterior_latest.json",
        "poll_interval": "3day",
        "method": "MCMC",
        "mcmc_budget_margin": "60s",
        "mcmc_realization_interval": 10,
        "calibration_window_days": 100,
        "mcmc_proposal_mode": "covariance",
        "mcmc_max_sweeps": 300,
        "mcmc_quorum_fraction": 0.25,
        "mcmc_stability_enabled": false,
        "calibration_output_dir": "outputs/calibration",
        "calibration_observations": [
            "Underdrain flow (m3/day)",
            "Soil Moisture",
            "Pond water depth (m)"
        ],
        "mcmc_seed_inflation": 1.05,
        "mcmc_drift_detection": true,
        "mcmc_cusum_k": 1.0,
        "mcmc_cusum_h": 5.0,
        "mcmc_drift_reference_cycles": 40,
        "mcmc_t2_window_cycles": 33,
        "mcmc_min_step_fraction": 0.0
    }
}
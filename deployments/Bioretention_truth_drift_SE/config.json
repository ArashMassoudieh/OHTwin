{
    "deployment": {
        "name": "Bioretention_truth_drift_SE",
        "model_file": "model/Bioretention.ohq",
        "viz_file": "viz_bioretention.json",
        "port": 8086
    },
    "runtime": {
        "weather_source": "openmeteo_historical",
        "latitude": 38.91088,
        "longitude": -76.98569,
        "interval": "1day",
        "forecast_horizon": "",
        "start_datetime": "2020-01-03T00:00:00",
        "stop_datetime": "2022-01-03T00:00:00",
        "time_acceleration": 200,
        "state_variables": [],
        "keep_debug_outputs": false
    },
    "observations": {
        "save_interval": "1hr",
        "noise_sigma": {
            "default": 0.0,
            "Precipitation": 0.0,
            "Groundwater Recharge": 0.0,
            "Infiltration rate": 0.0,
            "Overflow": 0.0,
            "inflow to the pond": 0.0,
            "Evaporation": 0.0,
            "Pond water depth": 0.003,
            "Soil Moisture": 0.02,
            "Underdrain flow": 1.0
        },
        "noise_correlation_time": "6hr",
        "noise_mode": "additive"
    },
    "parameter_drift": [
        {
            "parameter": "EngSoilKsat",
            "csv": "drift/ksat_drift.csv"
        }
    ]
}
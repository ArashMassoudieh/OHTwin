# starter_metadata:model_type=JM_Bioretention
# starter_metadata:build_mode=TruthDT
# starter_metadata:soil_param_strategy=JM_ProceduralReference

# JM_Bioretention: four-column model based on BP-01
# Columns: CC-101-1, CC-102-1, CC-103-1, CC-104-1
# Native grid: nx=1, nz=1
# Mode: Truth DT Simple with street gutters; runoff is routed through gutters and curb cuts, and underdrain is routed serially.

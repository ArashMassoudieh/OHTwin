{
    "deployment": {
        "name": "Bioretention_assimilation_MCMC",
        "model_file": "model/Bioretention.ohq",
        "viz_file": "viz_bioretention.json",
        "port": 8182
    },
    "runtime": {
        "weather_source": "openmeteo_historical",
        "latitude": 38.91088,
        "longitude": -76.98569,
        "interval": "1day",
        "forecast_horizon": "6day",
        "start_datetime": "2020-01-03T00:00:00",
        "stop_datetime": "2022-01-03T00:00:00",
        "time_acceleration": 1000,
        "advance_to_observations": true,
        "state_variables": [],
        "keep_debug_outputs": false
    },
    "observations": {
        "save_interval": "1hr",
        "noise_sigma": 0.0
    },
    "logging": {
        "enabled": true,
        "file": "outputs/debug.log",
        "categories": ["assim", "mcmc", "snapshot"],
        "flush_every": 1,
        "truncate": true
    },
    "assimilation": {
        "truth_csv_url": "http://localhost:8084/outputs/selected_output.csv",
        "truth_meta_url": "http://localhost:8084/outputs/selected_output_meta.json",
        "poll_interval": "3day",
        "method": "MCMC",
        "mcmc_budget_margin": "60s",
        "calibration_output_dir": "outputs/calibration",
        "calibration_observations": [
            "Underdrain flow (m3/day)",
            "Soil Moisture",
            "Pond water depth (m)"
        ]
    }
}

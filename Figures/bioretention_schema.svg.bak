     id="text21">Precipitation</text>
  <!-- ============ ponding zone ============ -->
  <g
     id="g22">
    <!-- pond block, 0 to surface (y=200) above the engineered soil -->
    <rect
       x="380"
       y="170"
       width="280"
       height="30"
       rx="3"
       fill="#D6E6F2"
       stroke="#1F4E79"

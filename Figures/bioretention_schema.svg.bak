    <!-- sensor symbol and its label below the path -->
    <circle
       cx="820"
       cy="350"
       r="6"
       fill="#E0832A"
       stroke="#7A4810"
       stroke-width="1.4"
       id="circle52" />
    <text
       x="820"
       y="354"
       font-size="9"
       font-weight="500"
       text-anchor="middle"
       fill="white"
       id="text53">Q</text>
    <text
       x="820"
       y="372"
       font-size="11"
       font-style="italic"

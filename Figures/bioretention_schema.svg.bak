       font-size="11"
       font-style="italic"
       text-anchor="middle"
       fill="#7A4810"
       id="text50">depth sensor</text>
  </g>
  <!-- soil moisture sensor inside engineered soil -->
  <g
     id="g51">
    <circle
       cx="500"
       cy="250"
       r="6"
       fill="#E0832A"
       stroke="#7A4810"
       stroke-width="1.4"

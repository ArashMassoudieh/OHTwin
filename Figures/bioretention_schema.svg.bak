       text-anchor="middle"
       fill="#5C4612"
       id="text25">
      K_sat = 10 m/d, θ_sat = 0.4, n = 1.41
    </text>
  </g>
  <!-- ============ aggregate storage ============ -->
  <g
     id="g28">
    <rect
       x="380"
       y="300"
       width="280"
       height="80"
       rx="3"
       fill="#D8D8D2"
       stroke="#555555"
       stroke-width="1.6"

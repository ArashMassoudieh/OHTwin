    </text>
  </g>
  <!-- ============ links: vertical infiltration cascade ============ -->
  <!-- catchment -> pond -->
  <path
     d="M 340 115 C 360 115, 360 175, 380 175"
     fill="none"
     stroke="#1F4E79"
     stroke-width="1.8"
     marker-end="url(#arrow)"
     id="path39" />
  <text
     x="358"
     y="158"
     font-size="11"
     font-style="italic"
     fill="#1F4E79"
     id="text40">runoff</text>
  <!-- pond -> engineered soil -->
  <line
     x1="430"
     y1="200"
     x2="430"
     y2="210"
     stroke="#1F4E79"
     stroke-width="1.8"
     marker-end="url(#arrow)"

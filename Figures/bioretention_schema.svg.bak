     x1="430"
     y1="450"
     x2="430"
     y2="460"
     stroke="#1F4E79"
     stroke-width="1.8"
     marker-end="url(#arrow)"
     id="line43" />
  <!-- native 2 -> native 3 -->
  <line
     x1="430"
     y1="520"
     x2="430"
     y2="530"
     stroke="#1F4E79"
     stroke-width="1.8"
     marker-end="url(#arrow)"
     id="line44" />
  <!-- native 3 -> groundwater -->
  <line
     x1="430"
     y1="590"
     x2="430"
     y2="615"
     stroke="#1F4E79"
     stroke-width="1.8"
     marker-end="url(#arrow)"

    <text
       x="500"
       y="254"
       font-size="9"
       font-weight="500"
       text-anchor="middle"
       fill="white"
       id="text51">θ</text>
  </g>
  <!-- underdrain flow sensor on the underdrain line -->
  <g
     id="g54">
    <!-- single, clear underdrain label centered above the link -->
    <text
       x="770"
       y="343"
       font-size="12.5"
       font-style="italic"
       text-anchor="middle"
       fill="#1F4E79"
       id="text52">

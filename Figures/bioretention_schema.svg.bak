  <text
     x="438"
     y="610"
     font-size="11"
     font-style="italic"
     fill="#1F4E79"
     id="text45">recharge</text>
  <!-- ============ overflow weir link (pond -> catch basin) ============ -->
  <path
     d="M 660 178 C 760 178, 800 195, 880 200"
     fill="none"
     stroke="#A03020"
     stroke-width="2"
     marker-end="url(#arrow-overflow)"
     id="path45" />
  <text
     x="740"
     y="172"
     font-size="12.5"
     font-style="italic"
     fill="#A03020"
     id="text46">
    overflow weir
  </text>
  <!-- ============ underdrain link (aggregate -> catch basin) ============ -->
  <!-- The riser is a vertical pipe inside the aggregate from the invert (-1.1m,
       y=378 just above the aggregate bottom at 380) up to the riser crest
       (-0.5m, y=350). Water then exits horizontally to the right at the riser
       crest elevation and routes to the catch basin. -->
  <!-- Riser pipe (vertical, inside aggregate) -->
  <line
     x1="600"
     y1="350"
     x2="600"
     y2="378"
     stroke="#1F4E79"
     stroke-width="3"
     stroke-linecap="round"
     id="line46" />
  <!-- riser crest cap -->
  <line
     x1="592"
     y1="350"
     x2="608"
     y2="350"
     stroke="#1F4E79"
     stroke-width="2.5"
     id="line47" />
  <!-- Underdrain: from riser crest (600, 350), route horizontally to the
       catch basin's left side at the same elevation (y=350, ≈ −0.5 m). -->
  <path
     d="M 600 350 L 880 350"
     fill="none"
     stroke="#1F4E79"
     stroke-width="2"
     marker-end="url(#arrow)"
     id="path47" />
  <!-- ============ catch basin -> receiving water ============ -->
  <line
     x1="960"
     y1="408"
     x2="960"
     y2="448"
     stroke="#1F4E79"
     stroke-width="1.8"
     marker-end="url(#arrow)"
     id="line48" />
  <!-- ============ Evapotranspiration arrow (from engineered soil upward) ============ -->
  <path
     d="M 580 200 L 580 130"
     fill="none"
     stroke="#2E7D5B"
     stroke-width="1.8"
     stroke-dasharray="5 3"
     marker-end="url(#arrow-gray)"
     id="path48" />
  <text
     x="590"
     y="138"
     font-size="12.5"
     font-style="italic"
     fill="#2E7D5B"
     id="text48">
    ET (Penman, ×c_E)
  </text>
  <!-- ============ sensor markers ============ -->
  <!-- ponding depth sensor: little gauge symbol above the pond -->
  <g
     id="g50">
    <circle
       cx="500"
       cy="173"
       r="6"
       fill="#E0832A"
       stroke="#7A4810"
       stroke-width="1.4"
       id="circle48" />
    <text
       x="500"
       y="177"
